# ─────────────────────────────────────────────────────────────
# PRECEPTOR — server environment (copy to .env, never commit .env)
# These values are read ONLY by the Node backend (server/).
# Nothing here is bundled into the browser or the Android app.
# ─────────────────────────────────────────────────────────────

# ── AI providers ────────────────────────────────────────────
# Set any of the keys. Every AI request goes to the first
# configured provider (AI_PROVIDER_ORDER) that can read the input; if it
# fails (bad key, quota, outage, unreachable), the next one is tried.
#   Gemini   — text, page images and voice notes
#   Kimi     — text and page images
#   DeepSeek — text only
#   OpenAI, Claude — text and page images
# With no key at all, cases, manual entry and the synthetic demo still work;
# real-case AI features show "GEMINI API KEY NOT CONFIGURED".

# Google Gemini key from https://aistudio.google.com/apikey
# (new AI Studio keys start with "AQ."; older ones with "AIza").
GEMINI_API_KEY=

# Gemini model id. Any current generateContent model with image input works.
# Google retires model versions over time: if Settings shows
# "GEMINI MODEL NOT AVAILABLE", list current models with
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
# and set a current Flash model here. Aliases such as gemini-flash-latest also
# work but follow Google's newest release (and its quota tier).
# Several models can be listed, separated by commas: the first is preferred and the
# others are used automatically when it is out of quota or overloaded (each Gemini
# model has its own free quota). Example: gemini-3-flash-preview,gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview

# studio (default) = Google AI Studio key · vertex = Vertex AI express-mode key
# (the key's Google Cloud project must have the Vertex AI API enabled).
# GEMINI_BACKEND=studio

# DeepSeek key from https://platform.deepseek.com/api_keys (needs account credit).
DEEPSEEK_API_KEY=
# Default deepseek-v4-flash. If the key does not offer the default, the server
# switches to the newest deepseek-v*-flash it lists; a model you set here is
# used exactly as written.
# DEEPSEEK_MODEL=deepseek-v4-flash
# disabled (default, faster) | enabled (reasoning mode)
# DEEPSEEK_THINKING=disabled

# Kimi (Moonshot AI) key from https://platform.kimi.ai (or platform.moonshot.cn).
KIMI_API_KEY=
# Default kimi-k2.6 (text + images). KIMI_VISION_MODEL overrides the model used for page images.
# KIMI_MODEL=kimi-k2.6
# KIMI_VISION_MODEL=
# Keys only work in their own region. Without this setting the server tries
# https://api.moonshot.ai/v1 and, if the key is rejected there, https://api.moonshot.cn/v1.
# KIMI_API_BASE=https://api.moonshot.ai/v1
# disabled (default, faster) | enabled (reasoning mode)
# KIMI_THINKING=disabled

# OpenAI key from https://platform.openai.com/api-keys. Text and page images.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Claude key from https://console.anthropic.com. Text and page images.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Failover order for automatic mode. Users can also pick a preferred provider
# in Settings; the others remain as fallback.
AI_PROVIDER_ORDER=gemini,deepseek,kimi,openai,anthropic

# HTTP port for the API (and for the built PWA in production).
PORT=8787

# ── Optional ────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (CORS).
# Same-origin requests are always allowed. Add the Capacitor origin
# (https://localhost) when you ship the Android app.
# ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# Optional shared access code. When set, every /api/ai/* call must send
# "Authorization: Bearer <code>" (entered once in Settings → Server).
# This protects your AI quotas on a public deployment. It is NOT a provider key.
# APP_ACCESS_TOKEN=

# SQLite file for the technical AI audit log (no patient content is stored).
# DATABASE_PATH=./data/preceptor.sqlite

# AI request limits / cost control
# AI_RATE_LIMIT_PER_MINUTE=30
# AI_TIMEOUT_MS=90000
# AI_MAX_RETRIES=2
# AI_CACHE_TTL_MINUTES=60
